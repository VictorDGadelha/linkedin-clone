generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── frente 1 ───────────────────────────────────────────────
model Vaga {
  id              String   @id @default(uuid())
  titulo          String
  empresa         String
  empresaSlug     String
  area            String
  senioridade     String
  local           String
  aceitaIniciante Boolean  @default(false)
  descricao       String
  criadaEm        DateTime @default(now())

  // frente 4
  arquivada       Boolean  @default(false)
}

// ─── frente 2 ───────────────────────────────────────────────
model Empresa {
  slug      String   @id
  nome      String
  sobre     String
  site      String
  editadaEm DateTime @updatedAt
}
